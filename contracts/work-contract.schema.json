{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xuanling.example/contracts/work-contract.schema.json",
  "title": "DCP Bounded Work Contract Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "stable_life_id",
    "transition_id",
    "capability_id",
    "actor_id",
    "carrier_id",
    "receiver",
    "affected_receivers",
    "state"
  ],
  "properties": {
    "contract_id": {"type": "string", "minLength": 1},
    "stable_life_id": {"type": "string", "minLength": 1},
    "transition_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "carrier_id": {"type": "string", "minLength": 1},
    "receiver": {"type": "string", "minLength": 1},
    "affected_receivers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "state": {"const": "CANDIDATE"}
  }
}
